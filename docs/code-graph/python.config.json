{
  "language": "python",
  "include": [
    "services/**/*.py",
    "backend/**/*.py"
  ],
  "exclude": [
    "**/.venv/**",
    "**/build/**",
    "**/dist/**",
    "**/__pycache__/**",
    "**/migrations/**"
  ],
  "entryPoints": [
    {
      "type": "file",
      "pattern": "services/eye_tracking/entrypoints/server.py"
    },
    {
      "type": "file",
      "pattern": "services/eye_tracking/entrypoints/pupil_server.py"
    },
    {
      "type": "file",
      "pattern": "services/eye_tracking/entrypoints/huahong_server.py"
    },
    {
      "type": "file",
      "pattern": "services/facial_analysis/server.py"
    },
    {
      "type": "file",
      "pattern": "backend/license_admin/manage.py"
    }
  ],
  "output": "docs/code-graph/python.json"
}
