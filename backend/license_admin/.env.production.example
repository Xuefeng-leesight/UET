# 域名必须先解析到服务器公网 IP，且安全组/防火墙开放 TCP 80、443。
LICENSE_DOMAIN=license.example.com
LETSENCRYPT_EMAIL=admin@example.com

DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
LICENSE_SIGNING_KEY_ID=ust-prod-01
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_PUBLIC_KEYS={}
DEVICE_SECRET_ENCRYPTION_KEY=
# 安装包上传上限：6 GiB（6442450944 字节），覆盖 2-5G 大文件
LICENSE_MAX_UPLOAD_BYTES=6442450944

POSTGRES_DB=ust_license
POSTGRES_USER=ust
POSTGRES_PASSWORD=replace-with-a-long-random-password

GUNICORN_WORKERS=3
# 大文件上传需要较长的 worker 超时；下载已走 X-Accel-Redirect 不受此限制
GUNICORN_TIMEOUT=300
# nginx 请求体上限：8 GiB，略大于 LICENSE_MAX_UPLOAD_BYTES，覆盖 multipart 开销
NGINX_MAX_BODY_SIZE=8192m
