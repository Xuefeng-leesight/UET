# IP 访问部署环境变量（纯 HTTP，不含 HTTPS / nginx 证书 / certbot）。
# 复制为 .env.ip 并填写后，用 docker-compose.ip.yml 启动。

DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters

# IP 访问默认放通任意 Host（"*"）；如需收紧，改为逗号分隔的具体 IP，
# 例如 DJANGO_ALLOWED_HOSTS=192.168.1.100,10.0.0.5
DJANGO_ALLOWED_HOSTS=*

# 纯 HTTP 下留空即可；若未来切 HTTPS 再填 http(s)://域名 或 https://IP。
DJANGO_CSRF_TRUSTED_ORIGINS=

LICENSE_SIGNING_KEY_ID=ust-prod-01
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_PUBLIC_KEYS={}
DEVICE_SECRET_ENCRYPTION_KEY=
# 安装包上传上限：6 GiB（6442450944 字节），覆盖 2-5G 大文件
LICENSE_MAX_UPLOAD_BYTES=6442450944

POSTGRES_DB=ust_license
POSTGRES_USER=ust
POSTGRES_PASSWORD=replace-with-a-long-random-password

GUNICORN_WORKERS=3
# 大文件上传需要较长的 worker 超时；下载已走 X-Accel-Redirect 不受此限制
GUNICORN_TIMEOUT=300
